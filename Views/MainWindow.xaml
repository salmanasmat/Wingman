<Window x:Class="Wingman.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Wingman.Controls"
        Title="WINGMAN" Height="760" Width="1240"
        WindowState="Maximized"
        Background="{StaticResource BgMainBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        KeyDown="Window_KeyDown">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP BAR -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,8" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding HostnameText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Margin="0,0,20,0"/>
                    <TextBlock Text="{Binding UptimeText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource FgMutedBrush}"/>
                </StackPanel>

                <!-- Center Clock -->
                <TextBlock Grid.Column="1" Text="{Binding ClockText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}"/>

                <!-- Right Config -->
                <Button Grid.Column="2" Content="[ CONFIGURATION ]" Command="{Binding OpenConfigCommand}"
                        Style="{StaticResource ActionButtonStyle}" FontSize="13" Foreground="{StaticResource AccentCyanBrush}"/>
            </Grid>
        </Border>

        <!-- 2. ASYMMETRICAL MAIN CONTENT GRID -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.35*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- TOP ASYMMETRICAL ROW -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- TOP LEFT (60%): REACTOR CORE HERO CARD -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Header -->
                            <TextBlock Text="REACTOR CORE" Style="{StaticResource HeaderTextStyle}" FontSize="18"/>

                            <!-- Gauges Above (Side-by-Side Centered) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <controls:CircularGauge Value="{Binding CpuPercent}" Title="CPU LOAD" GaugeColor="{StaticResource AccentCyanBrush}" Width="165" Height="165" Margin="0,0,20,0"/>
                                <controls:CircularGauge Value="{Binding RamPercent}" Title="MEMORY" GaugeColor="{StaticResource AccentWarnBrush}" Width="165" Height="165"/>
                            </StackPanel>

                            <!-- OS Drive Capacity Bar Under Gauges -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="OS DRIVE CAPACITY" Style="{StaticResource SectionTextStyle}" FontSize="12" Margin="0,0,0,4"/>
                                <controls:LinearGauge Value="{Binding DiskPercent}" Label="{Binding DiskLabel}" BarColor="{StaticResource AccentCyanBrush}" Height="28"/>
                            </StackPanel>

                            <!-- Rest Info Under Gauges & Drive Bar (3-Column Grid) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Network Speeds -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="NETWORK SPEED" Style="{StaticResource SectionTextStyle}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding NetUpText}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                    <TextBlock Text="{Binding NetDownText}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                                </StackPanel>

                                <!-- Column 2: Disk IO Badges & Power Source -->
                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                    <TextBlock Text="DISK ACTIVITY" Style="{StaticResource SectionTextStyle}" FontSize="12" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Padding="8,4" CornerRadius="6" Margin="0,0,6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DiskReadActive}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text=" READ " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <Border Padding="8,4" CornerRadius="6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource ButtonBgBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DiskWriteActive}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentWarnBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text=" WRITE " FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding BatteryText}" Foreground="{Binding BatteryBrush}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>

                                <!-- Column 3: Top Load Processes -->
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="TOP LOAD" Style="{StaticResource SectionTextStyle}" FontSize="12" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding TopProcesses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource FgPrimaryBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- TOP RIGHT (40%): WATCHTOWER PING MONITOR -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <DockPanel>
                        <TextBlock Text="WATCHTOWER" Style="{StaticResource HeaderTextStyle}" FontSize="18" DockPanel.Dock="Top"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WatchtowerItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10" Padding="8" Background="{StaticResource InputBgBrush}" CornerRadius="8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}"/>
                                                    <TextBlock HorizontalAlignment="Right" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource FgMutedBrush}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}ms">
                                                                <Binding Path="LastMs"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                                <controls:SparklineChart History="{Binding History}" Status="{Binding Status}" Height="32"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- BOTTOM ASYMMETRICAL ROW -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <!-- BOTTOM LEFT (33%): LAUNCHPAD -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <DockPanel>
                        <TextBlock Text="LAUNCHPAD" Style="{StaticResource HeaderTextStyle}" FontSize="18" DockPanel.Dock="Top"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LaunchpadCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource SectionTextStyle}" FontSize="13"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="2"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding Label}" Command="{Binding LaunchCommand}" Style="{StaticResource ActionButtonStyle}" Margin="3" FontSize="13" Padding="10,8">
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Run as Administrator" Command="{Binding LaunchAdminCommand}"/>
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- BOTTOM MIDDLE (42%): NETWORK INTEL & SPECS -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,6,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="NETWORK INTEL &amp; SPECS" Style="{StaticResource HeaderTextStyle}" FontSize="18"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Net Intel Column -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="NETWORK DETAILS" Style="{StaticResource SectionTextStyle}" FontSize="12"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="LOCAL IP:"/>
                                    <TextBlock FontSize="14" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding LocalIp}" Margin="0,0,0,6"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="WAN IP:"/>
                                    <TextBlock FontSize="14" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding PublicIp}" Margin="0,0,0,6"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="MAC ADDR:"/>
                                    <TextBlock FontSize="14" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding Mac}" Margin="0,0,0,6"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="GATEWAY:"/>
                                    <TextBlock FontSize="14" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding Gateway}"/>
                                </StackPanel>

                                <!-- WiFi & Specs Column -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="WIFI &amp; SPECS" Style="{StaticResource SectionTextStyle}" FontSize="12"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="WIFI SSID:"/>
                                    <TextBlock FontSize="14" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding WifiSsid}" Margin="0,0,0,6"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="SYSTEM OS:"/>
                                    <TextBlock FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding SysOs}" Margin="0,0,0,6"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="CPU CORES:"/>
                                    <TextBlock FontSize="14" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding SysCores}" Margin="0,0,0,6"/>

                                    <TextBlock FontSize="11" Foreground="{StaticResource FgMutedBrush}" Text="RAM / STORAGE:"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding SysRamTotal}"/>
                                        <TextBlock FontSize="13" FontFamily="Consolas" Foreground="{StaticResource FgMutedBrush}" Text=" / "/>
                                        <TextBlock FontSize="13" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource FgPrimaryBrush}" Text="{Binding SysDiskCap}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- BOTTOM RIGHT (25%): QUICK NOTES -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <DockPanel>
                        <TextBlock Text="QUICK NOTES" Style="{StaticResource HeaderTextStyle}" FontSize="18" DockPanel.Dock="Top"/>
                        <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="8">
                            <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13"
                                     Foreground="{StaticResource FgPrimaryBrush}" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 3. BOTTOM STATUS TICKER -->
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="14,8" Style="{StaticResource CardStyle}" Cursor="Hand" MouseLeftButtonDown="BottomBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="[ VIEW EVENT LOGS ]" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
