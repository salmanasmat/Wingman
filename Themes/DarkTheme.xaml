<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High-Contrast Dark Mode Color Palette -->
    <Color x:Key="BgMainColor">#0F172A</Color>
    <Color x:Key="BgCardColor">#1E293B</Color>
    <Color x:Key="CardBorderColor">#334155</Color>
    <Color x:Key="FgPrimaryColor">#F8FAFC</Color>
    <Color x:Key="FgMutedColor">#94A3B8</Color>

    <Color x:Key="AccentCyanColor">#38BDF8</Color>
    <Color x:Key="AccentGreenColor">#34D399</Color>
    <Color x:Key="AccentWarnColor">#FBBF24</Color>
    <Color x:Key="AccentCritColor">#F87171</Color>

    <Color x:Key="ButtonBgColor">#334155</Color>
    <Color x:Key="ButtonHoverColor">#475569</Color>
    <Color x:Key="InputBgColor">#0F172A</Color>
    <Color x:Key="GaugeTrackColor">#334155</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgMainBrush" Color="{DynamicResource BgMainColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{DynamicResource BgCardColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource CardBorderColor}" />
    <SolidColorBrush x:Key="FgPrimaryBrush" Color="{DynamicResource FgPrimaryColor}" />
    <SolidColorBrush x:Key="FgMutedBrush" Color="{DynamicResource FgMutedColor}" />

    <SolidColorBrush x:Key="AccentCyanBrush" Color="{DynamicResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{DynamicResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentWarnBrush" Color="{DynamicResource AccentWarnColor}" />
    <SolidColorBrush x:Key="AccentCritBrush" Color="{DynamicResource AccentCritColor}" />

    <SolidColorBrush x:Key="ButtonBgBrush" Color="{DynamicResource ButtonBgColor}" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{DynamicResource ButtonHoverColor}" />
    <SolidColorBrush x:Key="InputBgBrush" Color="{DynamicResource InputBgColor}" />
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="{DynamicResource GaugeTrackColor}" />

    <!-- Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Text Style -->
    <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Section Text Style -->
    <Style x:Key="SectionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FgMutedBrush}" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Action Button Style -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
